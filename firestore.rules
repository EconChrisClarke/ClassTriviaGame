rules_version = '2';

// Security rules for Class Poll Bonanza.
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
//
// Who is who:
//  - Students sign in anonymously (automatic, invisible to them).
//  - Teachers sign in with Google AND must have a document in /teachers/{their uid}.
//    You add that document once, by hand, in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }
    function ownsGame(g) {
      return isTeacher()
        && get(/databases/$(database)/documents/games/$(g)).data.ownerUid == request.auth.uid;
    }

    match /teachers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // managed in the Firebase console only
    }

    // Question sets. Only their owner can see them, so students never see answers.
    match /quizzes/{id} {
      allow read, delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;
      allow create: if isTeacher() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isTeacher() && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
    }

    // Compressed question images. Readable by players so heatmap images reach phones.
    match /images/{id} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;
    }

    // A live game. The public doc never contains a correct answer until the question closes.
    match /games/{g} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isTeacher() && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;

      match /players/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || ownsGame(g));
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'studentId', 'joinedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.studentId is string
          && request.resource.data.studentId.size() > 0 && request.resource.data.studentId.size() <= 30;
      }

      // One answer per student per question, stamped with server time, never editable.
      match /answers/{aid} {
        allow read: if ownsGame(g);
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.q is int
          && aid == string(request.resource.data.q) + '_' + request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.keys().hasOnly(['uid', 'q', 'choice', 'x', 'y', 'at']);
      }

      // Scores and grades: teacher only.
      match /private/{docId} {
        allow read, write: if ownsGame(g);
      }
    }
  }
}
